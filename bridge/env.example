# Local VPS Bridge configuration (copy to bridge/.env, never commit real secrets)

BRIDGE_BIND_HOST=127.0.0.1
BRIDGE_PORT=8787

# Shared secret for local HTTP/WS access (and default fallback if VPS_AUTH_TOKEN is unset)
BRIDGE_AUTH_TOKEN=replace-with-long-random-secret

# Optional Cloudflare Worker relay endpoint (e.g. wss://agy-bridge.your-subdomain.workers.dev/v1/relay/vps)
RELAY_WS_URL=
# Optional separate VPS relay token if Worker uses split VPS_AUTH_TOKEN
RELAY_AUTH_TOKEN=

# Path to agy CLI binary and Antigravity data directory
AGY_BIN=/home/ubuntu/.local/bin/agy
AGY_DATA_DIR=/home/ubuntu/.gemini/antigravity-cli
AGY_DEFAULT_WORKSPACE=/home/ubuntu
AGY_DEFAULT_MODEL=gemini-3.8-flash-medium
